# Supabase Configuration
# Get these values from https://app.supabase.com/
# Project Settings -> API -> Project URL and anon/public key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=public-anon-key-here

# Google Sign-In (for Android Credential Manager)
# Optional - only needed if Google Sign-In is configured in Supabase
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini AI API Key
# If using Supabase Edge Functions for AI, this is set in the Supabase dashboard
# Project Settings -> Functions -> Environment Variables
# Do NOT hardcode real API keys in the app
GEMINI_API_KEY=MY_GEMINI_API_KEY
