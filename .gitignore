# Python verification suite
__pycache__/
*.pyc
.pytest_cache/

# Local Python virtualenv used by tests/python
.venv/

# Release artifacts (built by tool/build_release.py, uploaded to GitHub Releases)
*.apk
*.sha256

# Stray build/verification logs from local runs
build_*.log
release_report.txt

# JVM crash dumps. One of these (hs_err_pid13844.log) was committed by
# accident: it is a 2 MB native-memory crash trace, and it was produced by the
# -Xmx8G setting that android/gradle.properties no longer uses. Deleting it
# keeps machine-specific paths and memory layouts out of history, and these
# files must never be re-committed.
hs_err_pid*.log
replay_pid*.log

# Original, uncompressed recordings kept for re-encoding only.
# They are ~116 MB and must never be committed - the compressed clips
# in assets/videos/ are what ships.
assets/videos/source/

