<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen.  Flutter's legacy
         `android:windowBackground` layer-list still applies on older releases,
         so both paths show the same ribbon-W artwork. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/weekend_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/weekend_splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
