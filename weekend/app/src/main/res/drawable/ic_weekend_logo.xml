<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    
    <!-- Heart-W glyph path -->
    <path
        android:pathData="M16,22 C12,14 19,10 24,15 L32,24 L40,15 C45,10 52,14 48,22 L36,44 C34,47 30,47 28,44 Z"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="10"
                android:endX="48"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF6E59"/>
                <item android:offset="0.6" android:color="#FFFF4081"/>
                <item android:offset="1.0" android:color="#FFA239CA"/>
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="10"
                android:endX="48"
                android:endY="48"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF8A65"/>
                <item android:offset="1.0" android:color="#FFFF4081"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center inner heart curve -->
    <path
        android:pathData="M24,20 C22,16 26,13 29,17 L32,21 L35,17 C38,13 42,16 40,20 L33.5,30 C32.7,31.2 31.3,31.2 30.5,30 Z"
        android:strokeWidth="3.2"
        android:strokeColor="#FFFFFFFF"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Sparkle star top right -->
    <path
        android:pathData="M52,10 L53.5,14 L57.5,15.5 L53.5,17 L52,21 L50.5,17 L46.5,15.5 L50.5,14 Z"
        android:fillColor="#FFFFFFFF"/>
</vector>
